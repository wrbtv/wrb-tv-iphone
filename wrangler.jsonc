{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "wrbtv-iphone-pwa-20261016-3858215c",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WRBTV_IPHONE_CONTAINER",
        "class_name": "WRBTViPhoneNodeContainer"
      },
      {
        "name": "WRBTV_IPHONE_CONTAINER_V2",
        "class_name": "WRBTViPhoneNodeContainerV2"
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/stream",
      "/health"
    ],
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "exports": {
    "WRBTViPhoneNodeContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "WRBTViPhoneNodeContainerV2": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
